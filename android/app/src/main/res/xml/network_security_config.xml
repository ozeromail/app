<?xml version="1.0" encoding="utf-8"?>
<!-- Company mail servers often use a certificate authority installed on the device, by a work
     profile or by the person. Like other mail apps, trust those too. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
